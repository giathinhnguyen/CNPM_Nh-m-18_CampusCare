# Web
VITE_API_URL=http://localhost:3000/api

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
DATABASE_URL=postgresql://brewlite:brewlite@postgres:5432/brewlite

# Authentication
# Tu tao khoa bi mat va dien vao file .env
JWT_SECRET=

# Google Authentication
GOOGLE_CLIENT_ID=178546076569-css84bl58dmnm5e6qsj52n47m2577208.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=178546076569-css84bl58dmnm5e6qsj52n47m2577208.apps.googleusercontent.com

# Email verification (Gmail SMTP; enter an App Password in your local .env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=brewlite.team@gmail.com
SMTP_PASS=
SMTP_FROM="BrewLite <brewlite.team@gmail.com>"
REWARDS_TEST_PAYMENTS=false
BANK_TRANSFER_DEMO_ENABLED=true
CARD_DEMO_ENABLED=true
# VietQR receiver: enter your own account; leave blank to disable the real QR.
BANK_QR_BIN=
BANK_QR_BANK_NAME=
BANK_QR_ACCOUNT_NUMBER=
BANK_QR_ACCOUNT_NAME=

# Local PostgreSQL host port (use 5435 if 5432 is occupied)
POSTGRES_PORT=5435
# VNPay sandbox merchant credentials; never commit your hash secret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payments/return
# Public server IPv4 for VNPay query/refund requests; use loopback for local development.
VNPAY_API_IP=127.0.0.1

# ZaloPay sandbox: keys from merchant portal, never expose to frontend.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_RETURN_URL=http://localhost:5173/payments/zalopay/return
# Optional on localhost (server query works without it); public HTTPS when deployed.
ZALOPAY_CALLBACK_URL=
